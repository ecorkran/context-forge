{
  "name": "@context-forge/mcp",
  "version": "0.8.4",
  "description": "MCP server for Context Forge — generates structured AI context prompts from project configuration and templates",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "context-forge-mcp": "./dist/index.js"
  },
