  },
  "homepage": "https://github.com/ecorkran/context-forge/tree/main/packages/mcp-server#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@context-forge/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.1"
